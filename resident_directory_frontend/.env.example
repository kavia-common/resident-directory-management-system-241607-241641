# Frontend environment configuration
#
# Create React App only exposes variables prefixed with REACT_APP_.

# Base URL for the backend API (FastAPI)
# Example (local): http://localhost:3001
# Example (deployed): https://<your-backend-host>
# Preferred:
REACT_APP_API_BASE_URL=
#
# Also supported (alternative names, useful if your deployment system provides these):
# REACT_APP_BACKEND_URL=
# REACT_APP_API_BASE=
